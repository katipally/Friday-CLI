{
  "name": "@fridaycode/tools",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fridaycode/core": "workspace:*",
    "@fridaycode/providers": "workspace:*",
    "@fridaycode/shared": "workspace:*",
    "fast-glob": "^3.3.3",
    "puppeteer-core": "^24.40.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "author": "katipally",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/katipally/fridaycode.git",
    "directory": "packages/tools"
  },
  "publishConfig": {
    "access": "public"
  }
}
