{
  "name": "@fridaycode/core",
  "version": "0.1.0",
  "description": "Core agent engine, commands, sub-agents, skills, and cost tracking for FridayCode",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fridaycode/providers": "workspace:*",
    "@fridaycode/shared": "workspace:*",
    "better-sqlite3": "^12.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "author": "katipally",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/katipally/fridaycode.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["fridaycode", "agent", "core", "ai", "coding-agent", "sub-agents", "skills"]
}
