    "@google/genai": "^1.3.0",
    "@mistralai/mistralai": "^1.5.0",
    "groq-sdk": "^0.9.0",
    "eventsource-parser": "^3.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0"
  }
}
