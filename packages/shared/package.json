{
  "name": "@fridaycode/shared",
  "version": "0.1.0",
  "description": "Shared utilities, types, logging, SQLite database, and error handling for FridayCode",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "chalk": "^5.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "author": "katipally",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/katipally/fridaycode.git",
    "directory": "packages/shared"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["fridaycode", "shared", "utilities", "sqlite", "logging", "types"]
}
