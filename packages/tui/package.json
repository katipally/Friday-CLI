{
  "name": "@fridaycode/tui",
  "version": "0.1.0",
  "description": "Terminal UI components, themes, and keyboard shortcuts for FridayCode",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react",
    "dev": "tsup src/index.ts --format esm --dts --watch --external react",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fridaycode/core": "workspace:*",
    "@fridaycode/shared": "workspace:*",
    "chalk": "^5.3.0",
    "cli-highlight": "^2.1.11",
    "figures": "^6.0.0",
    "ink": "^5.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "author": "katipally",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/katipally/fridaycode.git",
    "directory": "packages/tui"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["fridaycode", "tui", "terminal-ui", "ink", "react", "themes", "components"]
}
