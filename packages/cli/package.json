{
  "name": "friday-cli",
  "version": "0.1.0",
  "description": "Open-source multi-provider AI coding agent for the terminal",
  "type": "module",
  "bin": {
    "friday": "./dist/bin/friday.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts src/bin/friday.ts --format esm --dts --clean",
    "dev": "tsx src/bin/friday.ts",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anthropic-ai/friday-shared": "workspace:*",
    "@anthropic-ai/friday-core": "workspace:*",
    "@anthropic-ai/friday-providers": "workspace:*",
    "@anthropic-ai/friday-tui": "workspace:*",
    "@anthropic-ai/friday-tools": "workspace:*",
    "@anthropic-ai/friday-mcp": "workspace:*",
    "@anthropic-ai/friday-i18n": "workspace:*",
    "@anthropic-ai/friday-indexer": "workspace:*",
    "commander": "^12.0.0",
    "ink": "^5.0.0",
    "react": "^18.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0"
  },
  "keywords": [
    "cli",
    "ai",
    "coding-agent",
    "llm",
    "openai",
    "anthropic",
    "gemini",
    "ollama",
    "terminal"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anthropic-ai/friday-cli"
  }
}
