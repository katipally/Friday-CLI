{
  "name": "fridaycode",
  "version": "0.1.0",
  "description": "Open-source multi-provider AI coding agent for the terminal",
  "type": "module",
  "bin": {
    "friday": "./dist/bin/friday.js",
    "fridaycode": "./dist/bin/friday.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin/friday.ts --format esm --dts --clean",
    "dev": "tsx src/bin/friday.ts",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fridaycode/shared": "workspace:*",
    "@fridaycode/core": "workspace:*",
    "@fridaycode/providers": "workspace:*",
    "@fridaycode/tui": "workspace:*",
    "@fridaycode/tools": "workspace:*",
    "@fridaycode/mcp": "workspace:*",
    "@fridaycode/i18n": "workspace:*",
    "@fridaycode/indexer": "workspace:*",
    "commander": "^12.0.0",
    "ink": "^5.0.0",
    "react": "^18.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0"
  },
  "keywords": [
    "cli",
    "ai",
    "coding-agent",
    "llm",
    "terminal",
    "openai",
    "anthropic",
    "ollama",
    "gemini",
    "friday"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/katipally/fridaycode.git",
    "directory": "packages/cli"
  },
  "author": "katipally",
  "homepage": "https://github.com/katipally/fridaycode",
  "bugs": {
    "url": "https://github.com/katipally/fridaycode/issues"
  }
}