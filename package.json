{
  "name": "fridaycode",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source agentic coding CLI — model-agnostic alternative to Claude Code",
  "workspaces": [
    "packages/shared",
    "packages/core",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev": "npm run dev --workspace=packages/cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "lint:fix": "eslint packages/*/src --ext .ts,.tsx --fix",
    "format": "prettier --write 'packages/*/src/**/*.{ts,tsx}'",
    "typecheck": "tsc --build",
    "clean": "rm -rf packages/*/dist packages/*/node_modules/.cache"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/user/fridaycode"
  },
  "keywords": [
    "ai",
    "coding",
    "cli",
    "agent",
    "terminal",
    "llm",
    "ollama",
    "openai",
    "anthropic"
  ],
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.39.4",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
