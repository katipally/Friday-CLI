{
  "name": "fridaycode-monorepo",
  "private": true,
  "description": "Open-source multi-provider AI coding agent for the terminal",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "typecheck": "turbo typecheck",
    "prepare": "husky",
    "build:binary": "node scripts/build-binary.mjs",
    "publish:all": "pnpm run build && pnpm -r publish --no-git-checks"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "author": "katipally",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/katipally/Friday-CLI.git"
  },
  "homepage": "https://github.com/katipally/Friday-CLI",
  "bugs": {
    "url": "https://github.com/katipally/Friday-CLI/issues"
  }
}